{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "macOS Toolbox",
  "version": "0.1.0",
  "identifier": "dev.havefun.macos-toolbox",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "beforeBuildCommand": "corepack pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "macOS Toolbox",
        "width": 1120,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
