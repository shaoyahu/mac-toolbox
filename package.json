{
  "name": "macos-toolbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "corepack pnpm --filter desktop dev",
    "build": "corepack pnpm --filter desktop build",
    "test": "corepack pnpm test:ui && corepack pnpm test:rust",
    "test:ui": "corepack pnpm --filter desktop test",
    "test:rust": "cargo test --workspace",
    "tauri": "corepack pnpm --filter desktop tauri"
  }
}
